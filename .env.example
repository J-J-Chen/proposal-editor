# Buoyant hiring AI proxy — a drop-in replacement for the official OpenAI/Anthropic SDKs.
# Copy this file to .env.local (gitignored) and fill in the token.
# The auth token is sent to you separately by Buoyant. DO NOT COMMIT the real token.

# Single token usable for BOTH providers (choose provider via baseURL below).
BUOYANT_PROXY_TOKEN=

# Proxy base URLs (defaults — override only if Buoyant changes them).
ANTHROPIC_BASE_URL=https://hiring-proxy.trybuoyant.ai/anthropic
OPENAI_BASE_URL=https://hiring-proxy.trybuoyant.ai/openai

# Vercel Blob — used only to upload a PDF's bytes when the parse cache misses (large files).
# Auto-injected when a Vercel Blob store is linked; set here for local upload testing.
BLOB_READ_WRITE_TOKEN=
